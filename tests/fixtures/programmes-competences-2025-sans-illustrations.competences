                "expectations": [],
                "skills": [
                  {
                    "id": "skill_1763469533436",
                    "name": "Diversifier les pronoms employés",
                    "referenceAges": [],
                    "image": null,
                    "description": "Avant 4 ans: il-elle/ils-elles, puis je\nA partir de 4 ans: tu, on\nA partir de 5 ans: nous, vous"
                  },
                  {
                    "id": "skill_1763469643835",
                    "name": "Construire à l’oral un système de temps de plus en plus efficace",
                    "referenceAges": [],
                    "image": null,
                    "description": "Avant 4 ans: Utiliser le présent puis en fin d’année, un système à trois temps : présent/passé composé/présent à valeur de futur proche (aller)\nA partir de 4 ans: utiliser l'imparfait et le passé composé, le conditionnel\nA partir de 5 ans:  un système à trois temps : imparfait/plus-que-parfait/imparfait à valeur de futur dans le passé (aller) ; le futur simple ; un système à deux temps futur/futur antérieur"
                  },
                  {
                    "id": "skill_1763469725828",
                    "name": "Formuler des énoncés de plus en plus complexes",
                    "referenceAges": [],
                    "image": null,
                    "description": "Avant 4 ans: premiers connecteurs : et/et puis\nA partir de 4 ans: nouveaux connecteurs temporels et spatiaux : d’abord/ensuite/après/pendant; afin de subordonner les propositions : parce que/que/qui\nA partir de 5 ans: e nouveaux introducteurs de complexité : où/quand/pour que/si/comme, etc"
                  }
                ],
