{
  "name": "envolees-web",
  "private": true,
  "version": "2.0.0",
  "description": "Envolées — version web installable (PWA) pour ordinateur et tablette.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "vite build && node tests/e2e/run.mjs",
    "sync": "node scripts/sync-desktop.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
